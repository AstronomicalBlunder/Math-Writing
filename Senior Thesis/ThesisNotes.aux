\@writefile{lot}{\contentsline {table}{\numberline {4.2.A}{\ignorespaces On the strip $0 < \mathfrak  {Re} \left ( \chi  \right ) < 1$ of each connected component of $\mathscr  {X}(F^\times )$ the zeta integral is computed with respect to the corresponding additive character, measure and standard function outlined in Table \ref {table: standard functions}. The zeta integrals themselves were tabulated in Table \ref {table: zeta functions and epsilon factors}. At non-Archimedean $F$, the $q$ denotes the size of its residue field, $m$ denotes the conductor of the (variable) additive character $\psi $, and $\omega $ denotes the unramified part of $\chi $ (which depends on choice of homomorphic retraction of $F^\times $ to $\mathcal  {O}_F^\times $).\relax }}{79}{table.caption.7}\protected@file@percent }
\newlabel{table: L-factors and zeta factors}{{4.2.A}{79}{On the strip $0 < \re {\chi } < 1$ of each connected component of $\fanx (F^\times )$ the zeta integral is computed with respect to the corresponding additive character, measure and standard function outlined in Table \ref {table: standard functions}. The zeta integrals themselves were tabulated in Table \ref {table: zeta functions and epsilon factors}. At non-Archimedean $F$, the $q$ denotes the size of its residue field, $m$ denotes the conductor of the (variable) additive character $\psi $, and $\omega $ denotes the unramified part of $\chi $ (which depends on choice of homomorphic retraction of $F^\times $ to $\calo _F^\times $).\relax }{table.caption.7}{}}
